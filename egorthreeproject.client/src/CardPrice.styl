:root
  --card-bg #f6d8ff
  --card-text white
  --border-radius .5rem
  
body
  // display grid
  place-items center
  min-height 100vh
  font-family 'Inter', sans-serif

.card_price, .card_details
    background var(--card-bg)
    color var(--card-text)
    padding 1rem

  .card_price
    span
      position relative

  .card_price
    display grid
    grid-column 1
    grid-row 2
    padding-top 0
    padding-bottom 0
    font-weight 500
    font-size: 16px
    border-radius var(--border-radius) var(--border-radius) 0 0
    text-align center
    font-family 'MyCustomFont'

    span
      position relative
      top 1rem
      background white
      color black
      padding: 10px 10px
      border-radius var(--border-radius)
      display: flex
      justify-content: center
      align-items: baseline

  .card_details
    grid-column span 2
    grid-row 3
    font-size 1.25rem
    border-bottom-right-radius: 0.5rem
    border-bottom-left-radius: 0.5rem

    p
      &:first-child
        margin-top 0
      &:last-child
        margin-bottom 0
